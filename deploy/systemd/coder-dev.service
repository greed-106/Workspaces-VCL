[Unit]
Description=Coder control plane (development instance, single node)
Documentation=https://coder.com/docs
# 不依赖任何数据库:coderd 自己会拉起内嵌 PostgreSQL。
# 等 kubelet 只是为了少一次"k8s 还没就绪"的建工作区失败。
After=network-online.target kubelet.service
Wants=network-online.target
# 需要 SSD 上的 TMPDIR;数据目录在根分区,随时可用。
RequiresMountsFor=__SSD_DATA__
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=__CODER_USER__
Group=__CODER_GROUP__
WorkingDirectory=__CODER_DIR__
Environment=HOME=__CODER_HOME__
Environment=TMPDIR=__TMPDIR__
# 需要额外工具链(go、node)时把它们的 bin 目录追加到这里。
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=__CODER_DIR__/build/coder_linux_amd64 \
    --global-config __GLOBAL_CONFIG__ \
    server \
    --http-address __HTTP_ADDR__ \
    --swagger-enable \
    --dangerous-allow-cors-requests=true \
    --dangerous-allow-path-app-sharing=true \
    --enable-terraform-debug-mode \
    --access-url __ACCESS_URL__ \
    --prometheus-enable \
    --prometheus-address 0.0.0.0:2114 \
    --prometheus-collect-agent-stats \
    --prometheus-collect-db-metrics
Restart=always
RestartSec=10
StandardOutput=append:__LOG_DIR__/coderd.log
StandardError=append:__LOG_DIR__/coderd.log

[Install]
WantedBy=multi-user.target
