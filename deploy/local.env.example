# 本机取值示例:部署配置里所有跟机器相关的值都集中在这个文件里。
#
# 用法:
#   cp deploy/local.env.example deploy/local.env   # local.env 已被 git 忽略
#   ${EDITOR:-vi} deploy/local.env                 # 按本机实际情况修改(下面都是示例值)
#   sudo deploy/install.sh                         # 替换占位符并安装 systemd 单元、脚本与 logrotate
#
# 仓库里的配置模板(systemd/、scripts/、logrotate/、hdd-volumes/)只写 __占位符__,
# 不含具体主机名、用户名或路径,换机器时只改这个文件。

# 运行 Coder 与容量服务的系统用户及其家目录
CODER_USER=coder
CODER_GROUP=coder
CODER_HOME=/home/coder

# 本仓库在本机的检出目录(控制面在这里构建与运行)
CODER_DIR=/srv/workspaces-vcl

# 控制面对外访问地址与监听地址(ACCESS_URL 必须是对外可达的地址)
ACCESS_URL=http://workspace.example.com
HTTP_ADDR=127.0.0.1:3001

# 存储路径:SSD 数据盘、临时目录、日志目录、控制面数据目录
SSD_DATA=/mnt/ssd-data
TMPDIR=/mnt/ssd-data/tmp
LOG_DIR=/mnt/ssd-data/logs
GLOBAL_CONFIG=/srv/workspaces-vcl/.coderv2

# 对外域名与反向代理(nginx)监听端口;ACCESS_URL 要与浏览器里输入的地址一致
DOMAIN=workspace.example.com
HTTP_PORT=80
CAPACITY_PORT=3999

# HDD 冷数据盘、卷目录与卷的 StorageClass
HDD_DATA=/mnt/hdd-data
VOLUME_ROOT=/mnt/hdd-data/volumes
VOLUME_STORAGE_CLASS=coder-hdd

# 集群:工作区命名空间、节点名(HDD 卷绑定到该节点)、kubeconfig
NAMESPACE=coder-workspaces
NODE_NAME=node1
KUBECONFIG=/home/coder/.kube/config
ADMIN_KUBECONFIG=/etc/kubernetes/admin.conf

# 容量口径(按本机硬件与预留策略修改,单位:核 / GiB / GB)
CAPACITY_BIND=127.0.0.1:3998
CPU_TOTAL=16
CPU_OVERCOMMIT=2
CPU_RESERVED=2
MEM_TOTAL_GIB=64
MEM_RESERVED_GIB=8
DISK_BUDGET_GB=1000
